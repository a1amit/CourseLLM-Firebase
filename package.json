{
  "name": "coursellm-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "echo 'Run services individually: pnpm dev:web, pnpm dev:ingestion, firebase emulators:start'",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:ingestion": "cd services/ingestion && uvicorn app.main:app --reload --port 8000",
    "docker:ingestion": "cd services/ingestion && docker-compose up --build",
    "docker:ingestion:down": "cd services/ingestion && docker-compose down",
    "build": "pnpm run --recursive build",
    "build:web": "pnpm --filter web build",
    "emulators": "firebase emulators:start",
    "test:api": "cd services/ingestion && PYTHONPATH=. pytest tests/ -v",
    "test:api:cov": "cd services/ingestion && PYTHONPATH=. pytest tests/ -v --cov=app --cov-report=term-missing",
    "test:e2e:api": "cd services/ingestion && PYTHONPATH=. pytest tests/test_e2e_pipeline.py -v -s"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "dataconnect-admin-generated": "link:src/dataconnect-admin-generated",
    "dataconnect-generated": "link:src/dataconnect-generated"
  }
}