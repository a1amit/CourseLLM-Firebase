# =============================================================================
# CourseLLM Firebase Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# NEVER commit .env.local to version control.

# =============================================================================
# Firebase Client Configuration (Required for all environments)
# =============================================================================
# Get these from Firebase Console > Project Settings > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# =============================================================================
# Google AI / Genkit Configuration
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# Local Development - Firebase Emulators
# =============================================================================
# Set to "true" to connect to local Firebase emulators instead of production.
# Start emulators with: firebase emulators:start
# Emulator UI available at: http://localhost:4000
#
# Emulator Ports:
#   - Auth:      9099
#   - Firestore: 8080
#   - Storage:   9199
#   - UI:        4000
#
# Note: NEXT_PUBLIC_ prefix is required for client-side access in Next.js

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# =============================================================================
# Firebase Admin SDK (Server-side / Testing)
# =============================================================================
# Option 1: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# Option 2: Service account JSON as a string (for CI/CD)
FIREBASE_SERVICE_ACCOUNT_JSON=your_service_account_json_here

# Enable test auth endpoints for e2e tests (do NOT enable in production!)
ENABLE_TEST_AUTH=false

# =============================================================================
# Notes
# =============================================================================
# - For local Next dev the project runs on port 9002 by default (see package.json)
# - Add http://localhost:9002 to Firebase/GitHub authorized domains/redirect URIs

# =============================================================================
# Python Ingestion Service API
# =============================================================================
# URL for the Python chunking/embedding service

# Used by the Chunking Lab UI to call the ingestion service.
NEXT_PUBLIC_INGESTION_URL=http://localhost:8000

# Back-compat (older name). Prefer NEXT_PUBLIC_INGESTION_URL.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Ingestion Service Embeddings (Optional)
# =============================================================================
# These variables are read by the *Python ingestion service* (Docker/Cloud Run),
# not by the Next.js client directly.
#
# If you select "OpenAI" or "OpenRouter" as the embedding provider in the UI,
# the ingestion service must have the corresponding key configured. If missing,
# the API will return HTTP 401.

# OpenAI embeddings
# OPENAI_API_KEY=your_openai_api_key_here
# Optional override (defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional default model (UI can override per request)
# OPENAI_EMBED_MODEL=text-embedding-3-small

# OpenRouter embeddings (recommended provider - no local model download needed)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Default model (qwen/qwen3-embedding-8b - 4096 dimensions, multilingual)
# OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# =============================================================================
# Vertex AI Embeddings (Optional - for Production)
# =============================================================================
# Required only if using Vertex AI embeddings via the Python service
# Set these on the SERVER where the Python API runs (not in Next.js)

# Google Cloud Project ID
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Cloud Location
# GOOGLE_CLOUD_LOCATION=global

# Enable Vertex AI for google-genai SDK
# GOOGLE_GENAI_USE_VERTEXAI=True

# Service Account Key Path (if not using Application Default Credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
