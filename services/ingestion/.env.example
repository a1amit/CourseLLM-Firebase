# Ingestion service environment variables
# Copy to `.env` (this file is gitignored) and fill in values.

# Enables Gemini-backed topic extraction.
# If not set, the service falls back to deterministic heuristic topics (and returns a warning).
GOOGLE_API_KEY=

# Optional alternate variable name supported by the service.
# GOOGLE_GENAI_API_KEY=

# Optional default Gemini model for topic extraction.
TOPIC_MODEL=gemini-2.5-flash-lite

# Optional: include Gemini error details in the /chunk warnings response.
# Container logs will still contain stack traces regardless.
TOPIC_DEBUG=false

# --- OpenRouter (used for embeddings and optional preprocessing) ---

# OpenRouter API key (create one at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Optional: default OpenRouter embeddings model (only used when EMBEDDING_PROVIDER=openrouter)
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Optional: OpenRouter attribution headers (recommended but not required)
# OPENROUTER_HTTP_REFERER=http://localhost:9002
# OPENROUTER_X_TITLE=CourseLLM (local)

# --- LLM Preprocessing (Markdown normalization before chunking) ---

# When enabled, the service will call OpenRouter Chat Completions to rewrite the input into clean Markdown
# before running deterministic chunking.
PREPROCESS_ENABLED=false

# Default preprocessing model (recommended for this project)
PREPROCESS_MODEL=amazon/nova-2-lite-v1:free

# Request timeout for the preprocessing call
PREPROCESS_TIMEOUT_S=60

# Safety limit to avoid sending extremely large inputs to the LLM
PREPROCESS_MAX_INPUT_CHARS=40000
