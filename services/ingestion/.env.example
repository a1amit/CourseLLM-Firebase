# Ingestion service environment variables
# Copy to `.env` (this file is gitignored) and fill in values.

# --- CORS Configuration ---
# By default, all origins are allowed (*) for easier development (Codespaces, etc.)
# For production, you may want to restrict this to specific origins:
# CORS_ALLOW_ORIGINS=https://your-domain.com,https://your-other-domain.com

# --- OpenRouter (used for embeddings and optional preprocessing) ---
# NOTE: OpenRouter is now the only embedding provider for this service.
# The local sentence-transformers option has been removed for faster Docker startup.

# OpenRouter API key (create one at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Default OpenRouter embeddings model (qwen/qwen3-embedding-8b recommended)
OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# --- LLM Preprocessing (Markdown normalization before chunking) ---

# When enabled, the service will call OpenRouter Chat Completions to rewrite the input into clean Markdown
# before running deterministic chunking.
PREPROCESS_ENABLED=false

# Default preprocessing model (recommended for this project)
PREPROCESS_MODEL=google/gemma-3-27b-it:free

# Request timeout for the preprocessing call
PREPROCESS_TIMEOUT_S=60

# Safety limit to avoid sending extremely large inputs to the LLM
PREPROCESS_MAX_INPUT_CHARS=40000
